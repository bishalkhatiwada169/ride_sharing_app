# Backend (Spring Boot) — copy to backend/.env or export via Compose
# Use CLIENT-OWNED credentials only.

SERVER_PORT=8080
ENVIRONMENT=local

DATABASE_URL=jdbc:postgresql://localhost:5432/ride_platform
DATABASE_USER=ride
DATABASE_PASSWORD=change_me

REDIS_URL=redis://localhost:6379

JWT_SECRET=change_me_to_a_long_random_secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

CORS_ALLOWED_ORIGINS=http://localhost:5173

MAP_API_KEY=
MAP_PROVIDER=

SMS_PROVIDER=mock
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=

PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CURRENCY_DEFAULT=NPR

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

STORAGE_PROVIDER=s3_compatible
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=
STORAGE_ENDPOINT=

# Comma-separated admin bootstrap (local profile only); prefer one-time CLI in production
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=

# LAN APK installs (admin Downloads page)
# APK_DOWNLOADS_DIR=../artifacts/apks
# APK_PUBLIC_BASE_URL=http://192.168.1.20:8080

# true = embedded Postgres (default local). false = external DATABASE_URL
DB_EMBEDDED=true
# FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/migration-postgis
