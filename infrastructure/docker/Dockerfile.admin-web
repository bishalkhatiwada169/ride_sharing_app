# syntax=docker/dockerfile:1
# OPTIONAL standalone admin image (nginx). Prefer embedding via backend/Dockerfile.
# Kept for local experiments only — Compose `full` profile no longer uses this.
#
#   docker build -f infrastructure/docker/Dockerfile.admin-web -t ride-admin .

FROM node:22-alpine AS build
WORKDIR /app
COPY apps/admin-web/package.json apps/admin-web/package-lock.json* ./
RUN npm ci || npm install
COPY apps/admin-web/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY infrastructure/nginx/admin.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
