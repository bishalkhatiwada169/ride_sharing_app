# Shared / orchestration environment (local & CI references)
# Copy to .env and fill with CLIENT-OWNED values. Never commit real secrets.

# --- Core ---
ENVIRONMENT=local
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Database ---
DATABASE_URL=jdbc:postgresql://localhost:5432/ride_platform
DATABASE_USER=ride
DATABASE_PASSWORD=change_me
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ride_platform

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Auth ---
JWT_SECRET=change_me_to_a_long_random_secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Local profile only — creates SUPER_ADMIN if missing (never use in production as-is)
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=

# true = embedded Postgres (no Docker). false = use DATABASE_URL / Compose PostGIS.
DB_EMBEDDED=true
# When using Docker PostGIS image, also set:
# FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/migration-postgis

# --- Maps ---
MAP_API_KEY=
MAP_PROVIDER=google_or_mapbox_or_other

# --- Push notifications ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Or path to service account JSON in secret store:
# GOOGLE_APPLICATION_CREDENTIALS=

# --- SMS / OTP ---
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=

# --- Payments ---
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CURRENCY_DEFAULT=NPR

# --- Object storage (documents, avatars) ---
STORAGE_PROVIDER=s3_compatible
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=
STORAGE_ENDPOINT=

# --- Observability (optional) ---
SENTRY_DSN=
LOG_LEVEL=INFO
