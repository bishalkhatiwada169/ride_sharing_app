API_BASE_URL=http://10.0.2.2:8080/api/v1
WS_BASE_URL=ws://10.0.2.2:8080/ws
# Edit src/config/env.ts for the active client config (Metro does not load this file yet).
ENVIRONMENT=local

# MAP-1: Google Maps Android API key is NOT loaded by Metro.
# Put the development key in android/local.properties (see android/local.properties.example):
#   GOOGLE_MAPS_ANDROID_API_KEY=your_dev_key_here
# Or export the same name in your shell before Gradle builds.
# Enable only Maps SDK for Android. Restrict key to package com.passengerapp + SHA-1.
GOOGLE_MAPS_ANDROID_API_KEY=
