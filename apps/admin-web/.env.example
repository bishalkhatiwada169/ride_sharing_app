# Admin web (Vite) — only PUBLIC, non-secret values belong in VITE_*
# Never put JWT secrets, payment secrets, or DB passwords here.
#
# Embedded deploy (Spring Boot :8080): leave VITE_API_BASE_URL and VITE_WS_BASE_URL
# unset so the UI uses same-origin `/api/v1` and `window.location`.
#
# Local Vite HMR (:5173): leave unset (dev proxy) OR set absolute API URLs:

# VITE_API_BASE_URL=http://localhost:8080/api/v1
# SockJS base: origin OR …/ws — client strips a trailing /ws so it never becomes /ws/ws
# VITE_WS_BASE_URL=http://localhost:8080

VITE_MAP_API_KEY=
VITE_ENVIRONMENT=local
VITE_SENTRY_DSN=
